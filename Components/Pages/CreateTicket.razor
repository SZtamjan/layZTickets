@page "/CreateTicket"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using layZTickets.Data
@using layZTickets.DataSets
@inject IDbContextFactory<AppDbContext> DbContextFactory

<PageTitle>Nowe Zgłoszenie</PageTitle>

<div class="desk-page">
    <header class="desk-page-header create-header">
        <div>
            <h1>Utwórz nowe zgłoszenie</h1>
            <p>Opisz napotkany problem, aby zespół techniczny mógł szybko przejąć temat.</p>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="alert alert-success" role="status">
            @successMessage
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger" role="alert">
            @errorMessage
        </div>
    }

    <EditForm Model="ticketDraft" OnSubmit="CreateTicketAsync" FormName="create-ticket-form" class="create-ticket-grid">
        <div class="create-main-column">
            <section class="desk-card">
                <div class="form-stack">
                    <div>
                        <label for="ticket-title">Tytuł zgłoszenia</label>
                        <InputText id="ticket-title" class="desk-input" @bind-Value="ticketDraft.Title" placeholder="Np. Problem z logowaniem do systemu VPN" />
                        @if (submitted && string.IsNullOrWhiteSpace(ticketDraft.Title))
                        {
                            <div class="validation-message">Podaj tytuł zgłoszenia.</div>
                        }
                    </div>

                    <div>
                        <label for="ticket-description">Opis problemu</label>
                        <InputTextArea id="ticket-description" class="desk-input desk-textarea" @bind-Value="ticketDraft.Description" placeholder="Podaj szczegóły problemu, komunikaty o błędach oraz kroki, które doprowadziły do usterki..." />
                        @if (submitted && string.IsNullOrWhiteSpace(ticketDraft.Description))
                        {
                            <div class="validation-message">Opisz, czego dotyczy ticket.</div>
                        }
                    </div>

                    <div>
                        <label for="created-by">Zgłaszający</label>
                        <InputText id="created-by" class="desk-input" @bind-Value="ticketDraft.CreatedByUserId" placeholder="Imię i nazwisko lub login" />
                        @if (submitted && string.IsNullOrWhiteSpace(ticketDraft.CreatedByUserId))
                        {
                            <div class="validation-message">Podaj osobę zgłaszającą.</div>
                        }
                    </div>
                </div>
            </section>

            <section class="desk-card attachment-drop">
                <label>Załączniki</label>
                <div>
                    <span class="material-symbols-outlined" aria-hidden="true">cloud_upload</span>
                    <strong>Kliknij lub przeciągnij plik tutaj</strong>
                    <p>PNG, JPG, PDF, TXT (Max 10MB)</p>
                </div>
            </section>
        </div>

        <aside class="create-side-column">
            <section class="desk-card">
                <div class="form-stack">
                    <div>
                        <label>Kategoria</label>
                        <div class="category-list">
                            <label>
                                <input type="radio" name="category" value="hardware" checked />
                                <span class="material-symbols-outlined" aria-hidden="true">laptop_mac</span>
                                Sprzęt
                            </label>
                            <label>
                                <input type="radio" name="category" value="software" />
                                <span class="material-symbols-outlined" aria-hidden="true">terminal</span>
                                Oprogramowanie
                            </label>
                            <label>
                                <input type="radio" name="category" value="network" />
                                <span class="material-symbols-outlined" aria-hidden="true">router</span>
                                Sieć
                            </label>
                            <label>
                                <input type="radio" name="category" value="other" />
                                <span class="material-symbols-outlined" aria-hidden="true">more_horiz</span>
                                Inne
                            </label>
                        </div>
                    </div>

                    <div>
                        <label for="ticket-priority">Priorytet</label>
                        <InputSelect id="ticket-priority" class="desk-input" @bind-Value="ticketDraft.Priority">
                            <option value="Low">Niski (Informacyjne)</option>
                            <option value="Normal">Normalny (Standardowe zgłoszenie)</option>
                            <option value="High">Wysoki (Krytyczna awaria)</option>
                            <option value="Critical">Pilny (Praca wstrzymana)</option>
                        </InputSelect>
                    </div>

                    <div>
                        <label for="assigned-agent">Przypisany agent</label>
                        <InputText id="assigned-agent" class="desk-input" @bind-Value="ticketDraft.AssignedAgentId" placeholder="Opcjonalnie" />
                    </div>
                </div>
            </section>

            <section class="desk-card action-card">
                <button class="desk-primary-button wide" type="submit" disabled="@isSaving">
                    <span class="material-symbols-outlined" aria-hidden="true">send</span>
                    @(isSaving ? "Wysyłanie..." : "Wyślij zgłoszenie")
                </button>
                <a class="desk-secondary-button wide" href="DisplayTickets">Anuluj</a>
            </section>

            <section class="info-card">
                <span class="material-symbols-outlined" aria-hidden="true">info</span>
                <p>Twoje zgłoszenie zostanie zapisane w bazie i pojawi się na liście najnowszych ticketów.</p>
            </section>
        </aside>
    </EditForm>
</div>

@code {
    private Ticket ticketDraft = CreateEmptyTicket();
    private bool submitted;
    private bool isSaving;
    private string? successMessage;
    private string? errorMessage;

    private async Task CreateTicketAsync()
    {
        submitted = true;
        successMessage = null;
        errorMessage = null;

        if (!IsValid())
        {
            return;
        }

        isSaving = true;

        try
        {
            ticketDraft.Status = "New";
            ticketDraft.TicketNumber = string.Empty;
            ticketDraft.CreatedAt = DateTime.UtcNow;
            ticketDraft.UpdatedAt = null;
            ticketDraft.ClosedAt = null;
            ticketDraft.Comments = new List<TicketComment>();

            await using var dbContext = await DbContextFactory.CreateDbContextAsync();

            dbContext.Tickets.Add(ticketDraft);
            await dbContext.SaveChangesAsync();

            ticketDraft.TicketNumber = FormatTicketNumber(ticketDraft.Id);
            await dbContext.SaveChangesAsync();

            successMessage = $"Ticket {ticketDraft.TicketNumber} został utworzony.";
            ticketDraft = CreateEmptyTicket();
            submitted = false;
        }
        catch (Exception exception)
        {
            errorMessage = $"Nie udało się zapisać ticketu: {exception.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private bool IsValid()
    {
        return !string.IsNullOrWhiteSpace(ticketDraft.Title)
            && !string.IsNullOrWhiteSpace(ticketDraft.Description)
            && !string.IsNullOrWhiteSpace(ticketDraft.CreatedByUserId);
    }

    private static Ticket CreateEmptyTicket()
    {
        return new Ticket
        {
            Status = "New",
            Priority = "Normal"
        };
    }

    private static string FormatTicketNumber(int id)
    {
        return $"IT-{id:0000}";
    }
}
