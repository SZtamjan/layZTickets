@page "/admin"
@attribute [Authorize(Roles = "Admin")]
@using layZTickets.Data
@using layZTickets.DataSets
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@inject UserManager<ApplicationUser> UserManager
@inject AccountAdministration AccountAdministration
@inject IDbContextFactory<AppDbContext> DbContextFactory
@inject NavigationManager Navigation
@inject ILogger<AdminPanel> Logger

<PageTitle>Panel administratora — layZTickets</PageTitle>

<h1>Panel administratora</h1>

@if (AccountCreated)
{
    <div class="alert alert-success" role="status">
        Konto użytkownika zostało utworzone. Można zalogować się podanym adresem e-mail i hasłem.
    </div>
}

@if (RoleUpdated)
{
    <div class="alert alert-success" role="status">Rola i kategoria konta zostały zapisane.</div>
}

<button type="button" class="desk-primary-button" popovertarget="create-user-panel">
    Utwórz użytkownika
</button>

<button type="button" class="desk-secondary-button" popovertarget="account-role-panel">
    Zmień rolę lub kategorię
</button>

<section class="accounts-section desk-card" aria-labelledby="accounts-title">
    <header class="accounts-header">
        <h2 id="accounts-title">Konta użytkowników</h2>
        @if (accountsErrorMessage is null)
        {
            <span class="desk-muted">Liczba kont: @accounts.Count</span>
        }
    </header>

    @if (accountsErrorMessage is not null)
    {
        <div class="alert alert-danger" role="alert">
            @accountsErrorMessage
            <a href="/admin">Spróbuj ponownie</a>
        </div>
    }
    else if (accounts.Count == 0)
    {
        <p class="desk-muted">Nie utworzono jeszcze żadnego konta.</p>
    }
    else
    {
        <div class="accounts-table-scroll" tabindex="0" role="region" aria-label="Tabela kont — przewijanie poziome">
            <table class="accounts-table">
                <caption class="visually-hidden">Lista kont: imię, nazwisko, login, rola i kategoria.</caption>
                <thead>
                    <tr>
                        <th scope="col">Imię</th>
                        <th scope="col">Nazwisko</th>
                        <th scope="col">Login / e-mail</th>
                        <th scope="col">Rola</th>
                        <th scope="col">Kategoria agenta</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var account in accounts)
                    {
                        <tr @key="account.Id">
                            <td>@account.FirstName</td>
                            <td>@account.LastName</td>
                            <td>@account.Login</td>
                            <td>@(account.IsAdmin ? "Administrator" : account.IsAgent ? "Agent" : "Użytkownik")</td>
                            <td>@(account.IsAgent ? GetCategoryName(account.AgentCategory) : "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

<section id="create-user-panel" class="create-user-drawer" popover="auto" aria-labelledby="create-user-title"
         data-reopen="@(showCreateUserPanel ? "true" : "false")">

    <button type="button" class="desk-secondary-button" popovertarget="create-user-panel" popovertargetaction="hide">
        Zamknij
    </button>

    <h2 id="create-user-title">Utwórz użytkownika</h2>

    <p>Adres e-mail będzie również loginem. Nowe konto nie otrzyma uprawnień administratora.</p>

    <EditForm Model="newUserData" OnSubmit="CreateAccount" FormName="create-user" method="post" class="create-user-form">
        <DataAnnotationsValidator />

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert alert-danger" role="alert" tabindex="-1" data-form-feedback>
                @errorMessage
            </div>
        }

        <ValidationSummary />

        <div>
            <label for="new-user-first-name">Imię</label>
            <InputText id="new-user-first-name" class="desk-input" autocomplete="off"
                       @bind-Value="newUserData.FirstName" />
        </div>

        <div>
            <label for="new-user-last-name">Nazwisko</label>
            <InputText id="new-user-last-name" class="desk-input" autocomplete="off"
                       @bind-Value="newUserData.LastName" />
        </div>

        <div>
            <label for="new-user-email">Adres e-mail / login</label>
            <InputText id="new-user-email" class="desk-input" type="email" autocomplete="off"
                       @bind-Value="newUserData.Email" />
        </div>

        <div>
            <label for="new-user-role">Rola</label>
            <InputSelect id="new-user-role" class="desk-input" @bind-Value="newUserData.Role">
                <option value="@AccountRole.User">Użytkownik</option>
                <option value="@AccountRole.Agent">Agent</option>
            </InputSelect>
        </div>

        <div>
            <label for="new-user-category">Kategoria (wymagana dla agenta)</label>
            <InputSelect id="new-user-category" class="desk-input" @bind-Value="newUserData.AgentCategory">
                <option value="">Bez kategorii</option>
                @foreach (var category in Enum.GetValues<TicketCategory>())
                {
                    <option value="@category">@GetCategoryName(category)</option>
                }
            </InputSelect>
        </div>

        <div>
            <label for="new-user-password">Hasło</label>
            <InputText id="new-user-password" class="desk-input" type="password" autocomplete="new-password"
                       @bind-Value="newUserData.Password" />
            <p class="password-hint">
                Minimum @UserManager.Options.Password.RequiredLength znaków, mała i wielka litera, cyfra oraz znak specjalny.
            </p>
        </div>

        <div>
            <label for="new-user-confirm-password">Powtórz hasło</label>
            <InputText id="new-user-confirm-password" class="desk-input" type="password" autocomplete="new-password"
                       @bind-Value="newUserData.ConfirmPassword" />
        </div>

        <button type="submit" class="desk-primary-button">Utwórz użytkownika</button>
    </EditForm>
</section>

<section id="account-role-panel" class="create-user-drawer" popover="auto" aria-labelledby="account-role-title"
         data-reopen="@(showRolePanel ? "true" : "false")">
    <button type="button" class="desk-secondary-button" popovertarget="account-role-panel" popovertargetaction="hide">Zamknij</button>
    <h2 id="account-role-title">Rola i kategoria konta</h2>
    <p>Możesz nadać lub odebrać rolę agenta i zmienić jego kategorię. Niepasujące przypisania zgłoszeń zostaną wyczyszczone. Konta administratorów są chronione.</p>
    <EditForm Model="accountRoleData" OnSubmit="UpdateAccountRole" FormName="account-role" method="post" class="create-user-form">
        <DataAnnotationsValidator />
        @if (roleErrorMessage is not null)
        {
            <div class="alert alert-danger" role="alert" tabindex="-1" data-form-feedback>@roleErrorMessage</div>
        }
        <ValidationSummary />
        <div>
            <label for="role-account">Konto</label>
            <InputSelect id="role-account" class="desk-input" @bind-Value="accountRoleData.AccountId">
                <option value="">Wybierz konto</option>
                @foreach (var account in accounts.Where(account => !account.IsAdmin))
                {
                    <option value="@account.Id">@account.FirstName @account.LastName — @account.Login</option>
                }
            </InputSelect>
        </div>
        <div>
            <label for="account-role">Nowa rola</label>
            <InputSelect id="account-role" class="desk-input" @bind-Value="accountRoleData.Role">
                <option value="@AccountRole.User">Użytkownik</option>
                <option value="@AccountRole.Agent">Agent</option>
            </InputSelect>
        </div>
        <div>
            <label for="account-agent-category">Kategoria (wymagana dla agenta)</label>
            <InputSelect id="account-agent-category" class="desk-input" @bind-Value="accountRoleData.AgentCategory">
                <option value="">Bez kategorii</option>
                @foreach (var category in Enum.GetValues<TicketCategory>())
                {
                    <option value="@category">@GetCategoryName(category)</option>
                }
            </InputSelect>
        </div>
        <button type="submit" class="desk-primary-button">Zapisz rolę i kategorię</button>
    </EditForm>
</section>

@code {
    private string? errorMessage;
    private bool showCreateUserPanel;
    private string? accountsErrorMessage;
    private List<AccountListItem> accounts = new();
    private bool showRolePanel;
    private string? roleErrorMessage;

    [SupplyParameterFromForm(FormName = "account-role")]
    private AccountRoleData accountRoleData { get; set; } = new();

    [SupplyParameterFromForm(FormName = "create-user")]
    private UserData newUserData { get; set; } = new();

    [SupplyParameterFromQuery(Name = "accountCreated")]
    public bool AccountCreated { get; set; }

    [SupplyParameterFromQuery(Name = "roleUpdated")]
    public bool RoleUpdated { get; set; }

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (HttpContext?.User.IsInRole("Admin") != true)
        {
            accountsErrorMessage = "Nie masz uprawnień do przeglądania kont.";
            return;
        }

        try
        {
            await using var dbContext = await DbContextFactory.CreateDbContextAsync();

            accounts = await dbContext.Users
                .AsNoTracking()
                .OrderBy(user => user.LastName)
                .ThenBy(user => user.FirstName)
                .ThenBy(user => user.UserName)
                .Select(user => new AccountListItem(user.Id, user.FirstName, user.LastName, user.UserName ?? string.Empty,
                    user.AgentCategory,
                    dbContext.UserRoles.Any(membership => membership.UserId == user.Id &&
                        dbContext.Roles.Any(role => role.Id == membership.RoleId && role.NormalizedName == "ADMIN")),
                    dbContext.UserRoles.Any(membership => membership.UserId == user.Id &&
                        dbContext.Roles.Any(role => role.Id == membership.RoleId && role.NormalizedName == "AGENT"))))
                .ToListAsync();
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Błąd podczas pobierania listy kont.");
            accountsErrorMessage = "Nie udało się pobrać listy kont. Spróbuj ponownie później.";
        }
    }

    private sealed record AccountListItem(string Id, string FirstName, string LastName, string Login,
        TicketCategory? AgentCategory, bool IsAdmin, bool IsAgent);

    private async Task CreateAccount(EditContext editContext)
    {
        errorMessage = null;
        showCreateUserPanel = true;

        try
        {
            // Kontrola operacji na serwerze oprócz ochrony całej strony.
            if (HttpContext?.User.Identity?.IsAuthenticated != true || !HttpContext.User.IsInRole("Admin"))
            {
                errorMessage = "Nie masz uprawnień do tworzenia kont.";
                return;
            }

            newUserData.Email = (newUserData.Email ?? string.Empty).Trim();
            newUserData.FirstName = (newUserData.FirstName ?? string.Empty).Trim();
            newUserData.LastName = (newUserData.LastName ?? string.Empty).Trim();

            if (!editContext.Validate())
            {
                errorMessage = "Popraw dane formularza. Ze względów bezpieczeństwa wpisz hasło ponownie.";
                return;
            }

            var result = await AccountAdministration.CreateAsync(newUserData, HttpContext.User);

            if (!result.Succeeded)
            {
                errorMessage = string.Join(" ", result.Errors.Select(GetIdentityErrorMessage));
                return;
            }

            // Nowe żądanie GET zapobiega ponownemu wysłaniu hasła po odświeżeniu strony.
            Navigation.NavigateTo("/admin?accountCreated=true", forceLoad: true);
        }
        catch (Exception exception) when (exception is not NavigationException)
        {
            Logger.LogError(exception, "Błąd podczas tworzenia konta użytkownika.");
            errorMessage = "Nie udało się utworzyć konta. Spróbuj ponownie później.";
        }
        finally
        {
            // Hasło nie powinno wracać w HTML odpowiedzi ani pozostawać w modelu formularza.
            newUserData.Password = string.Empty;
            newUserData.ConfirmPassword = string.Empty;
        }
    }

    private async Task UpdateAccountRole(EditContext editContext)
    {
        showRolePanel = true;
        roleErrorMessage = null;
        try
        {
            if (HttpContext?.User.Identity?.IsAuthenticated != true || !HttpContext.User.IsInRole("Admin"))
            { roleErrorMessage = "Nie masz uprawnień do zmiany ról."; return; }
            if (!editContext.Validate())
            { roleErrorMessage = "Popraw dane formularza."; return; }

            var result = await AccountAdministration.SetRoleAsync(accountRoleData, HttpContext.User);
            if (!result.Succeeded)
            {
                roleErrorMessage = string.Join(" ", result.Errors.Select(GetIdentityErrorMessage));
                return;
            }
            Navigation.NavigateTo("/admin?roleUpdated=true", forceLoad: true);
        }
        catch (Exception exception) when (exception is not NavigationException)
        {
            Logger.LogError(exception, "Błąd podczas zmiany roli konta.");
            roleErrorMessage = "Nie udało się zmienić roli konta. Spróbuj ponownie później.";
        }
    }

    private static string GetCategoryName(TicketCategory? category) => category switch
    {
        TicketCategory.Hardware => "Sprzęt",
        TicketCategory.Software => "Oprogramowanie",
        TicketCategory.Network => "Sieć",
        TicketCategory.Other => "Inne",
        _ => "Brak kategorii"
    };

    private string GetIdentityErrorMessage(IdentityError error) => error.Code switch
    {
        "Forbidden" or "InvalidAccountData" or "AccountMissing" or "ProtectedAdministrator" => error.Description,
        "DuplicateUserName" or "DuplicateEmail" => "Konto z tym adresem e-mail już istnieje.",
        "InvalidEmail" or "InvalidUserName" => "Podaj prawidłowy adres e-mail jako login.",
        "PasswordTooShort" => $"Hasło musi mieć co najmniej {UserManager.Options.Password.RequiredLength} znaków.",
        "PasswordRequiresDigit" => "Hasło musi zawierać cyfrę.",
        "PasswordRequiresLower" => "Hasło musi zawierać małą literę.",
        "PasswordRequiresUpper" => "Hasło musi zawierać wielką literę.",
        "PasswordRequiresNonAlphanumeric" => "Hasło musi zawierać znak specjalny.",
        "PasswordRequiresUniqueChars" => $"Hasło musi zawierać co najmniej {UserManager.Options.Password.RequiredUniqueChars} różnych znaków.",
        _ => "Nie udało się zapisać danych konta."
    };
}
