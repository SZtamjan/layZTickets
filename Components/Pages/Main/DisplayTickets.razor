@page "/DisplayTickets"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using layZTickets.Data
@using layZTickets.DataSets
@inject IDbContextFactory<AppDbContext> DbContextFactory
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ILogger<DisplayTickets> Logger

<PageTitle>Wszystkie Zgłoszenia</PageTitle>

<div class="desk-page">
    <header class="desk-page-header">
        <div>
            <h1>Wszystkie Zgłoszenia</h1>
            <p>Przeglądaj i zarządzaj najnowszymi zgłoszeniami w systemie.</p>
        </div>

        <a class="desk-primary-button" href="CreateTicket">
            <span class="material-symbols-outlined" aria-hidden="true">add</span>
            Nowe Zgłoszenie
        </a>
    </header>

    <form class="ticket-search" @onsubmit="ApplyFiltersAsync" @onsubmit:preventDefault>
        <label for="ticket-search">Wyszukaj zgłoszenie</label>
        <div class="ticket-search-controls">
            <input id="ticket-search" class="desk-input" type="search" maxlength="200"
                   placeholder="Tytuł lub numer, np. IT-15" @bind="searchText" @bind:event="oninput" disabled="@isLoading" />
            <button class="desk-primary-button" type="submit" disabled="@isLoading">Szukaj</button>
        </div>
    </form>

    <section class="desk-filter-bar" aria-label="Filtry">
        <div class="filter-label">
            <span class="material-symbols-outlined" aria-hidden="true">filter_list</span>
            <span>Filtry:</span>
        </div>
        <select aria-label="Status" @bind="selectedStatus" @bind:after="ApplyFiltersAsync" disabled="@isLoading">
            <option value="">Status: Wszystkie</option>
            @foreach (var status in Enum.GetValues<TicketStatus>())
            {
                <option value="@status">@GetStatusName(status)</option>
            }
        </select>
        <select aria-label="Priorytet" @bind="selectedPriority" @bind:after="ApplyFiltersAsync" disabled="@isLoading">
            <option value="">Priorytet: Wszystkie</option>
            @foreach (var priority in Enum.GetValues<TicketPriority>())
            {
                <option value="@priority">@GetPriorityName(priority)</option>
            }
        </select>
        <select aria-label="Kategoria" @bind="selectedCategory" @bind:after="ApplyFiltersAsync" disabled="@isLoading">
            <option value="">Kategoria: Wszystkie</option>
            @foreach (var category in Enum.GetValues<TicketCategory>())
            {
                <option value="@category">@GetCategoryName(category)</option>
            }
        </select>
        <button type="button" @onclick="ClearFiltersAsync" disabled="@isLoading">Wyczyść wszystkie filtry</button>
    </section>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger" role="alert">
            @errorMessage
            <button class="retry-button" type="button" @onclick="LoadTicketsAsync" disabled="@isLoading">Spróbuj ponownie</button>
        </div>
    }
    else if (isLoading)
    {
        <p role="status" class="desk-muted">Ładowanie zgłoszeń...</p>
    }
    else if (tickets.Count == 0)
    {
        <div class="desk-empty" role="status">
            <h2>@(HasFilters ? "Brak pasujących zgłoszeń" : "Brak zgłoszeń")</h2>
            <p>@(HasFilters ? "Zmień wyszukiwane hasło lub wyczyść filtry." : "Nie masz jeszcze dostępnych zgłoszeń. Nowe zgłoszenie pojawi się na tej liście po utworzeniu.")</p>
        </div>
    }
    else
    {
        <section class="desk-table-card" aria-label="Lista ticketów">
            <div class="desk-table-scroll">
                <table class="desk-table">
                    <thead>
                        <tr>
                            <th scope="col">ID</th>
                            <th scope="col">Tytuł Zgłoszenia</th>
                            <th scope="col">Status</th>
                            <th scope="col">Priorytet</th>
                            <th scope="col">Zgłaszający</th>
                            <th scope="col">Przypisany</th>
                            <th scope="col">Utworzono</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ticket in tickets)
                        {
                            <tr>
                                <td>
                                    <a class="ticket-id" href="@($"DisplayTicket/{ticket.Id}")">
                                        #@ticket.TicketNumber
                                    </a>
                                </td>
                                <td>
                                    <a class="ticket-title-stack" href="@($"DisplayTicket/{ticket.Id}")">
                                        <strong>@ticket.Title</strong>
                                    </a>
                                </td>
                                <td>
                                    <span class="detail-chip">@GetStatusName(ticket.Status)</span>
                                </td>
                                <td>
                                    <span class="detail-chip">
                                        <span aria-hidden="true"></span>
                                        @GetPriorityName(ticket.Priority)
                                    </span>
                                </td>
                                <td>@ticket.CreatedByUser.DisplayName</td>
                                <td>
                                    <div class="agent-cell">
                                        <span>@GetInitials(ticket.AssignedAgent?.DisplayName)</span>
                                        <strong>@(ticket.AssignedAgent?.DisplayName ?? "Nieprzypisany")</strong>
                                    </div>
                                </td>
                                <td>@ticket.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <footer class="desk-table-footer">
                <span role="status">Pokazano @FirstResult–@LastResult z @totalCount zgłoszeń</span>
                <nav class="ticket-pagination" aria-label="Strony zgłoszeń">
                    <button type="button" aria-label="Poprzednia strona" disabled="@(isLoading || currentPage <= 1)"
                            @onclick="() => ChangePageAsync(currentPage - 1)">
                        <span class="material-symbols-outlined" aria-hidden="true">chevron_left</span>
                    </button>
                    <span aria-current="page">Strona @currentPage z @TotalPages</span>
                    <button type="button" aria-label="Następna strona" disabled="@(isLoading || currentPage >= TotalPages)"
                            @onclick="() => ChangePageAsync(currentPage + 1)">
                        <span class="material-symbols-outlined" aria-hidden="true">chevron_right</span>
                    </button>
                </nav>
            </footer>
        </section>
    }
</div>

@code {
    private List<TicketData> tickets = new();
    private const int PageSize = 20;
    private int currentPage = 1;
    private int totalCount;
    private string searchText = string.Empty;
    private string appliedSearch = string.Empty;
    private TicketStatus? selectedStatus;
    private TicketPriority? selectedPriority;
    private TicketCategory? selectedCategory;
    private bool isLoading;
    private string? errorMessage;

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(totalCount / (double)PageSize));
    private int FirstResult => totalCount == 0 ? 0 : (currentPage - 1) * PageSize + 1;
    private int LastResult => (currentPage - 1) * PageSize + tickets.Count;
    private bool HasFilters => appliedSearch.Length > 0 || selectedStatus.HasValue
        || selectedPriority.HasValue || selectedCategory.HasValue;

    protected override Task OnInitializedAsync() => LoadTicketsAsync();

    private async Task ApplyFiltersAsync()
    {
        if (isLoading) return;
        appliedSearch = searchText.Trim();
        currentPage = 1;
        await LoadTicketsAsync();
    }

    private async Task ClearFiltersAsync()
    {
        if (isLoading) return;
        searchText = string.Empty;
        selectedStatus = null;
        selectedPriority = null;
        selectedCategory = null;
        await ApplyFiltersAsync();
    }

    private async Task ChangePageAsync(int page)
    {
        if (isLoading || page < 1 || page > TotalPages) return;
        currentPage = page;
        await LoadTicketsAsync();
    }

    private async Task LoadTicketsAsync()
    {
        if (isLoading) return;
        isLoading = true;
        errorMessage = null;
        tickets = new();
        totalCount = 0;
        try
        {
            if ((selectedStatus.HasValue && !Enum.IsDefined(selectedStatus.Value))
                || (selectedPriority.HasValue && !Enum.IsDefined(selectedPriority.Value))
                || (selectedCategory.HasValue && !Enum.IsDefined(selectedCategory.Value)))
            {
                errorMessage = "Wybierz poprawne wartości filtrów lub wyczyść filtry.";
                return;
            }
            if (appliedSearch.Length > 200)
            {
                errorMessage = "Wyszukiwana fraza może mieć najwyżej 200 znaków.";
                return;
            }

            await using var dbContext = await DbContextFactory.CreateDbContextAsync();
            var authentication = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var actor = await TicketAccess.GetActorAsync(dbContext, authentication.User);
            if (actor is null)
            {
                errorMessage = "Zaloguj się ponownie, aby wyświetlić zgłoszenia.";
                return;
            }

            // Uprawnienia i wszystkie filtry są częścią zapytania SQL, także dla licznika.
            var query = TicketAccess.VisibleTickets(dbContext, actor).AsNoTracking();
            if (selectedStatus.HasValue)
                query = query.Where(ticket => ticket.Status == selectedStatus.Value);
            if (selectedPriority.HasValue)
                query = query.Where(ticket => ticket.Priority == selectedPriority.Value);
            if (selectedCategory.HasValue)
                query = query.Where(ticket => ticket.Category == selectedCategory.Value);
            if (appliedSearch.Length > 0)
            {
                // TicketNumber jest [NotMapped]; numer wyszukujemy przez kolumnę Id.
                var number = appliedSearch.TrimStart('#');
                if (number.StartsWith("IT-", StringComparison.OrdinalIgnoreCase))
                    number = number[3..];
                var ticketId = int.TryParse(number, out var parsedId) && parsedId > 0 ? parsedId : 0;
                query = query.Where(ticket => ticket.Title.Contains(appliedSearch) || ticket.Id == ticketId);
            }

            totalCount = await query.CountAsync();
            currentPage = Math.Clamp(currentPage, 1, TotalPages);
            tickets = await query
                .Include(ticket => ticket.CreatedByUser)
                .Include(ticket => ticket.AssignedAgent)
                .OrderByDescending(ticket => ticket.CreatedAt)
                .ThenByDescending(ticket => ticket.Id)
                .Skip((currentPage - 1) * PageSize)
                .Take(PageSize)
                .ToListAsync();
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Nie udało się pobrać listy zgłoszeń.");
            tickets = new();
            totalCount = 0;
            errorMessage = "Nie udało się pobrać zgłoszeń. Spróbuj ponownie.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private static string GetStatusName(TicketStatus status) => status switch
    {
        TicketStatus.New => "Nowe",
        TicketStatus.InProgress => "W trakcie",
        TicketStatus.Pending => "Oczekujące",
        TicketStatus.Closed => "Zamknięte",
        _ => "Nieznany status"
    };

    private static string GetPriorityName(TicketPriority priority) => priority switch
    {
        TicketPriority.Low => "Niski",
        TicketPriority.Normal => "Normalny",
        TicketPriority.High => "Wysoki",
        TicketPriority.Highest => "Najwyższy",
        _ => "Nieznany priorytet"
    };

    private static string GetCategoryName(TicketCategory category) => category switch
    {
        TicketCategory.Other => "Inne",
        TicketCategory.Hardware => "Sprzęt",
        TicketCategory.Software => "Oprogramowanie",
        TicketCategory.Network => "Sieć",
        _ => "Nieznana kategoria"
    };

    private static string GetInitials(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "NA";
        }

        var parts = value.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return string.Concat(parts.Take(2).Select(part => char.ToUpperInvariant(part[0])));
    }

}
