@page "/DisplayTickets"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using layZTickets.Data
@using layZTickets.DataSets
@inject IDbContextFactory<AppDbContext> DbContextFactory

<PageTitle>Wszystkie Zgłoszenia</PageTitle>

<div class="desk-page">
    <header class="desk-page-header">
        <div>
            <h1>Wszystkie Zgłoszenia</h1>
            <p>Przeglądaj i zarządzaj najnowszymi zgłoszeniami w systemie.</p>
        </div>

        <a class="desk-primary-button" href="CreateTicket">
            <span class="material-symbols-outlined" aria-hidden="true">add</span>
            Nowe Zgłoszenie
        </a>
    </header>

    <section class="desk-filter-bar" aria-label="Filtry">
        <div class="filter-label">
            <span class="material-symbols-outlined" aria-hidden="true">filter_list</span>
            <span>Filtry:</span>
        </div>
        <select aria-label="Status">
            <option>Status: Wszystkie</option>
            <option>Nowe</option>
            <option>W trakcie</option>
            <option>Rozwiązane</option>
        </select>
        <select aria-label="Priorytet">
            <option>Priorytet: Wszystkie</option>
            <option>Pilny</option>
            <option>Wysoki</option>
            <option>Normalny</option>
            <option>Niski</option>
        </select>
        <button type="button">Wyczyść wszystkie filtry</button>
    </section>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger" role="alert">
            @errorMessage
        </div>
    }
    else if (isLoading)
    {
        <p role="status" class="desk-muted">Ładowanie ticketów...</p>
    }
    else if (tickets.Count == 0)
    {
        <div class="desk-empty">
            <h2>Brak ticketów</h2>
            <p>Po utworzeniu pierwszego zgłoszenia pojawi się ono na tej liście.</p>
        </div>
    }
    else
    {
        <section class="desk-table-card" aria-label="Lista ticketów">
            <div class="desk-table-scroll">
                <table class="desk-table">
                    <thead>
                        <tr>
                            <th scope="col">ID</th>
                            <th scope="col">Tytuł Zgłoszenia</th>
                            <th scope="col">Status</th>
                            <th scope="col">Priorytet</th>
                            <th scope="col">Zgłaszający</th>
                            <th scope="col">Przypisany</th>
                            <th scope="col">Utworzono</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ticket in tickets)
                        {
                            var reporter = SplitReporterName(ticket.CreatedByUserId);

                            <tr>
                                <td>
                                    <a class="ticket-id" href="@($"DisplayTicket/{ticket.Id}")">
                                        #@ticket.TicketNumber
                                    </a>
                                </td>
                                <td>
                                    <a class="ticket-title-stack" href="@($"DisplayTicket/{ticket.Id}")">
                                        <strong>@ticket.Title</strong>
                                    </a>
                                </td>
                                <td>
                                    <span class="detail-chip">@ticket.Status</span>
                                </td>
                                <td>
                                    <span class="detail-chip">
                                        <span aria-hidden="true"></span>
                                        @ticket.Priority
                                    </span>
                                </td>
                                <td>@reporter.FirstName @reporter.LastName</td>
                                <td>
                                    <div class="agent-cell">
                                        <span>@GetInitials(ticket.AssignedAgentId)</span>
                                        <strong>@(string.IsNullOrWhiteSpace(ticket.AssignedAgentId) ? "Nieprzypisany" : ticket.AssignedAgentId)</strong>
                                    </div>
                                </td>
                                <td>@ticket.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <footer class="desk-table-footer">
                <span>Pokazano @tickets.Count z maksymalnie 10 najnowszych zgłoszeń</span>
                <div>
                    <button type="button" disabled>
                        <span class="material-symbols-outlined" aria-hidden="true">chevron_left</span>
                    </button>
                    <button type="button" class="active">1</button>
                    <button type="button" disabled>
                        <span class="material-symbols-outlined" aria-hidden="true">chevron_right</span>
                    </button>
                </div>
            </footer>
        </section>
    }
</div>

@code {
    private List<TicketData> tickets = new();
    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await using var dbContext = await DbContextFactory.CreateDbContextAsync();

            tickets = await dbContext.Tickets
                .AsNoTracking()
                .OrderByDescending(ticket => ticket.CreatedAt)
                .Take(10)
                .ToListAsync();
        }
        catch (Exception exception)
        {
            errorMessage = $"Nie udało się pobrać ticketów: {exception.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private static string GetStatusClass(string status)
    {
        return status.Equals("New", StringComparison.OrdinalIgnoreCase) || status.Equals("Nowe", StringComparison.OrdinalIgnoreCase)
            ? "status-chip status-new"
            : "status-chip status-progress";
    }

    private static string GetPriorityClass(string priority)
    {
        return priority.Equals("Critical", StringComparison.OrdinalIgnoreCase) || priority.Equals("High", StringComparison.OrdinalIgnoreCase)
            ? "priority-chip priority-high"
            : "priority-chip";
    }

    private static string GetInitials(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "NA";
        }

        var parts = value.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return string.Concat(parts.Take(2).Select(part => char.ToUpperInvariant(part[0])));
    }

    private static (string FirstName, string LastName) SplitReporterName(string reporter)
    {
        var parts = reporter.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

        return parts.Length switch
        {
            0 => ("Brak", "Brak"),
            1 => (parts[0], "Brak"),
            _ => (parts[0], string.Join(' ', parts.Skip(1)))
        };
    }
}
