@page "/CreateTicket"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using layZTickets.Data
@using layZTickets.DataSets
@using layZTickets.Components.Shared
@inject IDbContextFactory<AppDbContext> DbContextFactory
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ILogger<CreateTicket> Logger

<PageTitle>Nowe zgłoszenie — layZTickets</PageTitle>

<div class="desk-page">
    <header class="desk-page-header create-header">
        <div>
            <h1>Utwórz nowe zgłoszenie</h1>
            <p>Opisz napotkany problem, aby zespół techniczny mógł szybko przejąć temat.</p>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="alert alert-success" role="status">
            @successMessage
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger" role="alert">
            @errorMessage
        </div>
    }

    <EditForm Model="ticketDraft" OnSubmit="CreateTicketAsync" FormName="create-ticket-form" class="create-ticket-grid">
        <div class="create-main-column">
            <section class="desk-card">
                <div class="form-stack">
                    <div>
                        <label for="ticket-title">Tytuł zgłoszenia</label>
                        <InputText id="ticket-title" class="desk-input" @bind-Value="ticketDraft.Title" placeholder="Np. Problem z logowaniem do systemu VPN" />
                        @if (submitted && string.IsNullOrWhiteSpace(ticketDraft.Title))
                        {
                            <div class="validation-message">Podaj tytuł zgłoszenia.</div>
                        }
                    </div>

                    <div>
                        <label for="ticket-description">Opis problemu</label>
                        <InputTextArea id="ticket-description" class="desk-input desk-textarea" @bind-Value="ticketDraft.Description" placeholder="Podaj szczegóły problemu, komunikaty o błędach oraz kroki, które doprowadziły do usterki..." />
                        @if (submitted && string.IsNullOrWhiteSpace(ticketDraft.Description))
                        {
                            <div class="validation-message">Opisz, czego dotyczy zgłoszenie.</div>
                        }
                    </div>

                </div>
            </section>

            <section class="desk-card">
                <AttachmentPicker @key="attachmentVersion" Selected="selection => attachmentSelection = selection" Disabled="@isSaving" />
            </section>
        </div>

        <aside class="create-side-column">
            <section class="desk-card">
                <div class="form-stack">
                    <div>
                        <label>Kategoria</label>
                        <InputRadioGroup @bind-Value="ticketDraft.Category">
                            <div class="category-list">
                                <label>
                                    <InputRadio Value="TicketCategory.Hardware" />
                                    Sprzęt
                                </label>
                                <label>
                                    <InputRadio Value="TicketCategory.Software" />
                                    Oprogramowanie
                                </label>
                                <label>
                                    <InputRadio Value="TicketCategory.Network" />
                                    Sieć
                                </label>
                                <label>
                                    <InputRadio Value="TicketCategory.Other" />
                                    Inne
                                </label>
                            </div>
                        </InputRadioGroup>
                    </div>

                    <div>
                        <label for="ticket-priority">Priorytet</label>
                        <InputSelect id="ticket-priority" class="desk-input" @bind-Value="ticketDraft.Priority">
                            <option value="@TicketPriority.Low">Niski (Informacyjne)</option>
                            <option value="@TicketPriority.Normal">Normalny (Standardowe zgłoszenie)</option>
                            <option value="@TicketPriority.High">Wysoki (Krytyczna awaria)</option>
                            <option value="@TicketPriority.Highest">Najwyższy (Praca wstrzymana)</option>
                        </InputSelect>
                    </div>

                </div>
            </section>

            <section class="desk-card action-card">
                <button class="desk-primary-button wide" type="submit" disabled="@isSaving">
                    <span class="material-symbols-outlined" aria-hidden="true">send</span>
                    @(isSaving ? "Wysyłanie..." : "Wyślij zgłoszenie")
                </button>
                <a class="desk-secondary-button wide" href="DisplayTickets">Anuluj</a>
            </section>

            <section class="info-card">
                <span class="material-symbols-outlined" aria-hidden="true">info</span>
                <p>Twoje zgłoszenie zostanie zapisane w bazie i pojawi się na liście najnowszych zgłoszeń.</p>
            </section>
        </aside>
    </EditForm>
</div>

@code {
    private TicketData ticketDraft = CreateEmptyTicket();
    private bool submitted;
    private bool isSaving;
    private string? successMessage;
    private string? errorMessage;
    private AttachmentSelection attachmentSelection = AttachmentSelection.Empty;
    private int attachmentVersion;

    private async Task CreateTicketAsync()
    {
        if (isSaving)
        {
            return;
        }

        submitted = true;
        successMessage = null;
        errorMessage = null;

        if (!IsValid())
        {
            return;
        }

        if (!attachmentSelection.IsValid)
        {
            errorMessage = "Popraw wybór załączników lub wyczyść wybór plików.";
            return;
        }

        isSaving = true;

        try
        {
            var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = authenticationState.User;
            var userId = user.FindFirstValue(ClaimTypes.NameIdentifier);

            if (user.Identity?.IsAuthenticated != true || string.IsNullOrWhiteSpace(userId))
            {
                errorMessage = "Zaloguj się ponownie, aby utworzyć zgłoszenie.";
                return;
            }

            if (!Enum.IsDefined(ticketDraft.Category))
            {
                errorMessage = "Wybierz poprawną kategorię zgłoszenia.";
                return;
            }

            if (!Enum.IsDefined(ticketDraft.Priority))
            {
                errorMessage = "Wybierz poprawny priorytet zgłoszenia.";
                return;
            }

            await using var dbContext = await DbContextFactory.CreateDbContextAsync();

            if (!await dbContext.Users.AnyAsync(account => account.Id == userId))
            {
                errorMessage = "Konto użytkownika już nie istnieje. Zaloguj się ponownie.";
                return;
            }

            var ticket = new TicketData
            {
                Title = ticketDraft.Title.Trim(),
                Description = ticketDraft.Description.Trim(),
                Category = ticketDraft.Category,
                Priority = ticketDraft.Priority,
                CreatedByUserId = userId,
                AssignedAgentId = null,
                Status = TicketStatus.New,
                CreatedAt = DateTime.UtcNow
            };

            dbContext.Tickets.Add(ticket);
            var files = await AttachmentUpload.ReadAsync(attachmentSelection.Files);
            ticket.Attachments = AttachmentUpload.CreateEntities(files, userId);
            await dbContext.SaveChangesAsync();

            successMessage = $"Zgłoszenie {ticket.TicketNumber} zostało utworzone.";
            ticketDraft = CreateEmptyTicket();
            submitted = false;
            attachmentSelection = AttachmentSelection.Empty;
            attachmentVersion++;
        }
        catch (InvalidDataException exception)
        {
            errorMessage = exception.Message;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Nie udało się utworzyć zgłoszenia.");
            errorMessage = "Nie udało się zapisać zgłoszenia. Spróbuj ponownie.";
        }
        finally
        {
            isSaving = false;
        }
    }

    private bool IsValid()
    {
        return !string.IsNullOrWhiteSpace(ticketDraft.Title)
            && !string.IsNullOrWhiteSpace(ticketDraft.Description);
    }

    private static TicketData CreateEmptyTicket()
    {
        return new TicketData
        {
            Status = TicketStatus.New,
            Priority = TicketPriority.Normal
        };
    }
}
