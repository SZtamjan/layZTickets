@page "/Error"
@attribute [AllowAnonymous]
@using System.Diagnostics

<PageTitle>Błąd — layZTickets</PageTitle>

<h1>Wystąpił błąd</h1>
<p>Nie udało się wykonać tej operacji. Spróbuj ponownie lub wróć na stronę główną.</p>

@if (ShowRequestId)
{
    <p>
        <strong>Identyfikator błędu:</strong> <code>@RequestId</code>
    </p>
}

<a class="desk-primary-button" href="/">Wróć na stronę główną</a>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
