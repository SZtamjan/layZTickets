@page "/DisplayTicket"
@page "/DisplayTicket/{TicketId:int}"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using layZTickets.Data
@using layZTickets.DataSets
@using layZTickets.Components.Shared
@inject IDbContextFactory<AppDbContext> DbContextFactory
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ILogger<DisplayTicket> Logger

<PageTitle>Ticket</PageTitle>

<div class="ticket-detail-shell">
    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger" role="alert">
            @errorMessage
        </div>
    }
    else if (isLoading)
    {
        <p role="status" class="desk-muted">Ładowanie ticketu...</p>
    }
    else if (ticket is null)
    {
        <div class="desk-empty">
            <h1>Nie znaleziono ticketu</h1>
            <p>Wybrane zgłoszenie nie istnieje albo nie masz do niego dostępu.</p>
            <a class="desk-primary-button mt-3" href="DisplayTickets">Wróć do listy</a>
        </div>
    }
    else
    {
        <section class="ticket-hero">
            <div>
                <div class="ticket-hero-meta">
                    <span class="ticket-code">#@ticket.TicketNumber</span>
                    <span class="detail-chip">
                        <span class="material-symbols-outlined" aria-hidden="true">fiber_manual_record</span>
                        @if (canChangeStatus)
                        {
                            <InputSelect id="ticket-status" class="desk-input" @bind-Value:get="ticket.Status" @bind-Value:set="ChangeStatus" disabled="@isUpdating">
                                <option value="@TicketStatus.New">Nowe</option>
                                <option value="@TicketStatus.InProgress">W trakcie</option>
                                <option value="@TicketStatus.Pending">Oczekujące</option>
                                <option value="@TicketStatus.Closed">Zamknięte</option>
                            </InputSelect>
                        }
                        else
                        {
                            <span id="ticket-status">@GetStatusName(ticket.Status)</span>
                        }
                    </span>
                    <span class="detail-chip">
                        <span class="material-symbols-outlined" aria-hidden="true">priority_high</span>
                        <InputSelect id="ticket-priority" class="desk-input" @bind-Value:get="ticket.Priority" @bind-Value:set="ChangePriority" disabled="@(isUpdating || !canChangePriority)">
                            <option value="@TicketPriority.Low">Niski</option>
                            <option value="@TicketPriority.Normal">Normalny</option>
                            <option value="@TicketPriority.High">Wysoki</option>
                            <option value="@TicketPriority.Highest">Najwyższy</option>
                        </InputSelect>
                    </span>
                    @if (!string.IsNullOrWhiteSpace(updateErrorMessage))
                    {
                        <div class="comment-error" role="alert">@updateErrorMessage</div>
                    }
                </div>
                <h1>@ticket.Title</h1>
            </div>

            <div class="ticket-hero-actions">
                <a class="desk-secondary-button" href="DisplayTickets">
                    <span class="material-symbols-outlined" aria-hidden="true">arrow_back</span>
                    Lista
                </a>
            </div>
        </section>

        <div class="ticket-detail-grid">
            <main class="ticket-conversation">
                <section class="ticket-message-card">
                    <div class="message-author">
                        <div class="message-avatar">@GetInitials(ticket.CreatedByUser.DisplayName)</div>
                        <div>
                            <strong>@ticket.CreatedByUser.DisplayName</strong>
                            <span>@ticket.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span>
                        </div>
                    </div>
                    <p>@ticket.Description</p>
                    <AttachmentLinks Files="attachments.Where(file => file.TicketCommentId is null)" />
                </section>

                <section class="ticket-timeline">
                    <div class="timeline-line"></div>
                    <div class="timeline-event">
                        <span></span>
                        <div>
                            <strong>System</strong>
                            <p>Zgłoszenie utworzone i dodane do kolejki HelpDesk.</p>
                            <small>@ticket.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</small>
                        </div>
                    </div>

                    @foreach (var comment in ticket.Comments.OrderBy(comment => comment.CreatedAt))
                    {
                        <div class="timeline-event @(comment.IsInternal ? "internal" : null)">
                            <span></span>
                            <div>
                                <strong>@(comment.IsInternal ? "Notatka wewnętrzna" : "Odpowiedź")</strong>
                                <p class="comment-author">@comment.AuthorUser.DisplayName</p>
                                <p>@comment.Content</p>
                                <AttachmentLinks Files="attachments.Where(file => file.TicketCommentId == comment.Id)" />
                                <small>@comment.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</small>
                            </div>
                        </div>
                    }
                </section>

                <section class="reply-box">
                    @if (!string.IsNullOrWhiteSpace(commentErrorMessage))
                    {
                        <div class="comment-error" role="alert">@commentErrorMessage</div>
                    }

                    @if (canReply)
                    {
                        <textarea class="reply-textarea" @bind="commentContent" @bind:event="oninput" disabled="@isAddingComment" placeholder="@(canReadInternal ? "Wpisz odpowiedź lub notatkę..." : "Wpisz odpowiedź...")"></textarea>
                        <AttachmentPicker @key="replyAttachmentVersion" Selected="selection => replyAttachmentSelection = selection" Disabled="@isAddingComment" />
                        <footer>
                            @if (canReadInternal)
                            {
                                <button type="button" @onclick="() => AddCommentAsync(true)" disabled="@isAddingComment">
                                    <span class="material-symbols-outlined" aria-hidden="true">lock</span>
                                    Dodaj notatkę
                                </button>
                            }
                            <button class="send" type="button" @onclick="() => AddCommentAsync(false)" disabled="@isAddingComment">Wyślij odpowiedź</button>
                        </footer>
                    }
                    else
                    {
                        <p class="desk-muted">Nie masz uprawnień do odpowiadania na to zgłoszenie. Agent odpowiada tylko w swojej kategorii, a użytkownik — we własnych zgłoszeniach.</p>
                    }
                </section>
            </main>

            <aside class="ticket-side-panel">
                @if (canAssign)
                {
                    <AgentAssignment @key="ticket.Id" TicketId="ticket.Id" Assigned="HandleAssigned" />
                }

                <section class="side-card">
                    <h2>Szczegóły</h2>
                    <dl>
                        <div>
                            <dt>Użytkownik</dt>
                            <dd>@ticket.CreatedByUser.DisplayName</dd>
                        </div>
                        <div>
                            <dt>Kategoria</dt>
                            <dd>@GetCategoryName(ticket.Category)</dd>
                        </div>
                        <div>
                            <dt>Przypisany agent</dt>
                            <dd>@(ticket.AssignedAgent?.DisplayName ?? "Nieprzypisany")</dd>
                        </div>
                        <div>
                            <dt>Data utworzenia</dt>
                            <dd>@ticket.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</dd>
                        </div>
                        <div>
                            <dt>Ostatnia aktualizacja</dt>
                            <dd>@FormatDate(ticket.UpdatedAt)</dd>
                        </div>
                        <div>
                            <dt>Zamknięto</dt>
                            <dd>@FormatDate(ticket.ClosedAt)</dd>
                        </div>
                    </dl>
                </section>

                <section class="side-card attachments-card">
                    <h2>Załączniki</h2>
                    @if (attachments.Count == 0)
                    {
                        <p class="attachment-empty">Brak załączników</p>
                    }
                    <AttachmentLinks Files="attachments" />
                    @if (canReply)
                    {
                        <p class="desk-muted">Dodaj pliki widoczne dla uczestników zgłoszenia.
                            @if (canReadInternal)
                            {
                                <span>Prywatne pliki dołącz do notatki wewnętrznej.</span>
                            }
                        </p>
                        <AttachmentPicker @key="ticketAttachmentVersion" Selected="selection => ticketAttachmentSelection = selection" Disabled="@isAddingAttachments" />
                        <button type="button" @onclick="AddAttachmentsAsync" disabled="@(isAddingAttachments || ticketAttachmentSelection.Files.Count == 0 || !ticketAttachmentSelection.IsValid)">
                            @(isAddingAttachments ? "Wysyłanie..." : "Dodaj załączniki")
                        </button>
                    }
                    @if (attachmentErrorMessage is not null)
                    {
                        <p class="comment-error" role="alert">@attachmentErrorMessage</p>
                    }
                </section>
            </aside>
        </div>
    }
</div>

@code {
    [Parameter]
    public int? TicketId { get; set; }

    private TicketData? ticket;
    private bool isLoading = true;
    private bool isUpdating = false;
    private bool isAddingComment;
    private string commentContent = string.Empty;
    private string? errorMessage;
    private string? commentErrorMessage;
    private string? updateErrorMessage;
    private bool canReply;
    private bool canAssign;
    private bool canReadInternal;
    private bool canChangeStatus;
    private bool canChangePriority;
    private List<AttachmentInfo> attachments = new();
    private AttachmentSelection replyAttachmentSelection = AttachmentSelection.Empty;
    private AttachmentSelection ticketAttachmentSelection = AttachmentSelection.Empty;
    private int replyAttachmentVersion;
    private int ticketAttachmentVersion;
    private bool isAddingAttachments;
    private string? attachmentErrorMessage;
    private int? loadedTicketId;

    private void HandleAssigned(AgentAssignment.AssignmentResult result)
    {
        if (ticket?.Id != result.TicketId) return;
        ticket.AssignedAgentId = result.Agent.Id;
        ticket.AssignedAgent = result.Agent;
        ticket.UpdatedAt = result.UpdatedAt;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (loadedTicketId != TicketId)
        {
            commentContent = string.Empty;
            commentErrorMessage = null;
            attachmentErrorMessage = null;
            replyAttachmentSelection = AttachmentSelection.Empty;
            ticketAttachmentSelection = AttachmentSelection.Empty;
            replyAttachmentVersion++;
            ticketAttachmentVersion++;
            loadedTicketId = TicketId;
        }
        attachments = new();
        canReply = false; canAssign = false; canReadInternal = false;
        canChangeStatus = false; canChangePriority = false;
        ticket = null; errorMessage = null; isLoading = true;
        if (TicketId is null)
        {
            isLoading = false;
            return;
        }

        try
        {
            await using var dbContext = await DbContextFactory.CreateDbContextAsync();
            var authentication = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var actor = await TicketAccess.GetActorAsync(dbContext, authentication.User);
            if (actor is null)
            {
                errorMessage = "Zaloguj się ponownie, aby otworzyć zgłoszenie.";
                return;
            }
            canReadInternal = actor.CanReadInternal;
            canAssign = actor.CanAssign;

            ticket = await TicketAccess.VisibleTickets(dbContext, actor)
                .Include(ticket => ticket.CreatedByUser)
                .Include(ticket => ticket.AssignedAgent)
                .Include(ticket => ticket.Comments.Where(comment => canReadInternal || !comment.IsInternal))
                    .ThenInclude(comment => comment.AuthorUser)
                .AsNoTracking()
                .FirstOrDefaultAsync(ticket => ticket.Id == TicketId.Value);
            canReply = ticket is not null && actor.CanReply(ticket);
            canChangeStatus = ticket is not null && actor.CanChangeStatus;
            canChangePriority = ticket is not null && actor.CanChangePriority(ticket);
            if (ticket is not null)
                attachments = await AttachmentAccess.ListAsync(dbContext, actor, ticket.Id);
        }
        catch (Exception exception)
        {
            errorMessage = $"Nie udało się pobrać ticketu: {exception.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ChangeStatus(TicketStatus newStatus)
    {
        updateErrorMessage = null;

        if (isUpdating)
        {
            updateErrorMessage = "Trwa już aktualizacja zgłoszenia";
            return;
        }

        if (TicketId is null || ticket is null)
        {
            updateErrorMessage = "Nie wybrano ticketu.";
            return;
        }

        if (!Enum.IsDefined(newStatus))
        {
            updateErrorMessage = "Wybierz prawidłowy status.";
            return;
        }

        isUpdating = true;

        try
        {
            await using var dbContext = await DbContextFactory.CreateDbContextAsync();
            var authentication = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var actor = await TicketAccess.GetActorAsync(dbContext, authentication.User);
            if (actor?.CanChangeStatus != true)
            {
                updateErrorMessage = "Nie masz uprawnień do zmiany statusu zgłoszenia.";
                return;
            }

            var ticketToUpdate = await TicketAccess.VisibleTickets(dbContext, actor).FirstOrDefaultAsync(ticket => ticket.Id == TicketId.Value);

            var nowDate = DateTime.UtcNow;

            if (ticketToUpdate is not null)
            {
                ticketToUpdate.UpdatedAt = DateTime.UtcNow;
                ticketToUpdate.Status = newStatus;
                ticketToUpdate.ClosedAt = newStatus == TicketStatus.Closed ? nowDate : null;
            }
            else
            {
                errorMessage = "Zgłoszenie już nie istnieje.";
                return;
            }

            await dbContext.SaveChangesAsync();

            ticket.UpdatedAt = ticketToUpdate?.UpdatedAt ?? DateTime.UtcNow;
            ticket.Status = newStatus;
            ticket.ClosedAt = ticketToUpdate?.ClosedAt;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Nie udało się zmienić statusu zgłoszenia {TicketId}.", TicketId);
            updateErrorMessage = "Nie udało się zmienić statusu zgłoszenia. Spróbuj ponownie.";
        }
        finally
        {
            isUpdating = false;
        }
    }

    private async Task ChangePriority(TicketPriority newPriority)
    {
        updateErrorMessage = null;

        if (isUpdating)
        {
            updateErrorMessage = "Trwa już aktualizacja zgłoszenia";
            return;
        }

        if (TicketId is null || ticket is null)
        {
            updateErrorMessage = "Nie wybrano ticketu.";
            return;
        }

        if (!Enum.IsDefined(newPriority))
        {
            updateErrorMessage = "Wybierz prawidłowy priorytet.";
            return;
        }

        isUpdating = true;

        try
        {
            await using var dbContext = await DbContextFactory.CreateDbContextAsync();
            var authentication = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var actor = await TicketAccess.GetActorAsync(dbContext, authentication.User);
            if (actor is null)
            {
                updateErrorMessage = "Zaloguj się ponownie, aby zmienić priorytet.";
                return;
            }

            var ticketToUpdate = await TicketAccess.VisibleTickets(dbContext, actor).FirstOrDefaultAsync(ticket => ticket.Id == TicketId.Value);

            if (ticketToUpdate is not null)
            {
                ticketToUpdate.UpdatedAt = DateTime.UtcNow;
                ticketToUpdate.Priority = newPriority;
            }
            else
            {
                updateErrorMessage = "Nie znaleziono zgłoszenia lub nie masz do niego dostępu.";
                return;
            }

            await dbContext.SaveChangesAsync();

            ticket.UpdatedAt = ticketToUpdate?.UpdatedAt ?? ticket.UpdatedAt;
            ticket.Priority = newPriority;

        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Nie udało się zmienić priorytetu zgłoszenia {TicketId}.", TicketId);
            updateErrorMessage = "Nie udało się zmienić priorytetu zgłoszenia. Spróbuj ponownie.";
        }
        finally
        {
            isUpdating = false;
        }
    }

    private async Task AddCommentAsync(bool isInternal)
    {
        if (isAddingComment)
        {
            return;
        }

        commentErrorMessage = null;

        if (TicketId is null || ticket is null)
        {
            commentErrorMessage = "Nie można dodać komentarza bez wybranego ticketu.";
            return;
        }

        if (!replyAttachmentSelection.IsValid)
        {
            commentErrorMessage = "Popraw wybór załączników lub wyczyść wybór plików.";
            return;
        }

        if (string.IsNullOrWhiteSpace(commentContent) && replyAttachmentSelection.Files.Count == 0)
        {
            commentErrorMessage = "Wpisz treść komentarza lub wybierz załącznik.";
            return;
        }

        isAddingComment = true;
        var targetTicketId = ticket.Id;
        var content = commentContent.Trim();
        var selectedFiles = replyAttachmentSelection.Files;

        try
        {
            var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = authenticationState.User;
            var userId = user.FindFirstValue(ClaimTypes.NameIdentifier);

            if (user.Identity?.IsAuthenticated != true || string.IsNullOrWhiteSpace(userId))
            {
                commentErrorMessage = "Zaloguj się ponownie, aby dodać komentarz.";
                return;
            }

            var files = await AttachmentUpload.ReadAsync(selectedFiles);
            await using var dbContext = await DbContextFactory.CreateDbContextAsync();

            var actor = await TicketAccess.GetActorAsync(dbContext, user);
            if (actor is null)
            {
                commentErrorMessage = "Konto użytkownika już nie istnieje. Zaloguj się ponownie.";
                return;
            }
            var author = actor.Account;

            var ticketToUpdate = await TicketAccess.VisibleTickets(dbContext, actor).FirstOrDefaultAsync(ticket => ticket.Id == targetTicketId);
            if (ticketToUpdate is null)
            {
                commentErrorMessage = "Nie znaleziono zgłoszenia lub nie masz do niego dostępu.";
                return;
            }

            if (!actor.CanReply(ticketToUpdate) || (isInternal && !actor.CanReadInternal))
            {
                commentErrorMessage = "Nie masz uprawnień do dodania tej odpowiedzi lub notatki w kategorii zgłoszenia.";
                return;
            }

            var comment = new TicketComment
            {
                TicketId = targetTicketId,
                AuthorUserId = userId,
                Content = content,
                IsInternal = isInternal,
                CreatedAt = DateTime.UtcNow
            };

            dbContext.TicketComments.Add(comment);
            comment.Attachments = AttachmentUpload.CreateEntities(files, userId);
            foreach (var file in comment.Attachments) file.TicketId = ticketToUpdate.Id;
            ticketToUpdate.UpdatedAt = comment.CreatedAt;

            await dbContext.SaveChangesAsync();

            if (ticket?.Id == targetTicketId)
            {
                // Model widoku zachowuje treść komentarza i metadane, bez bajtów plików.
                ticket.Comments.Add(new TicketComment
                {
                    Id = comment.Id, TicketId = comment.TicketId, AuthorUserId = userId,
                    AuthorUser = author, Content = comment.Content, IsInternal = comment.IsInternal,
                    CreatedAt = comment.CreatedAt
                });
                attachments.AddRange(comment.Attachments.Select(ToAttachmentInfo));
                ticket.UpdatedAt = ticketToUpdate.UpdatedAt;
                commentContent = string.Empty;
                replyAttachmentSelection = AttachmentSelection.Empty;
                replyAttachmentVersion++;
            }
        }
        catch (InvalidDataException exception)
        {
            commentErrorMessage = exception.Message;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Nie udało się dodać komentarza do zgłoszenia {TicketId}.", TicketId);
            commentErrorMessage = "Nie udało się zapisać komentarza. Spróbuj ponownie.";
        }
        finally
        {
            isAddingComment = false;
        }
    }

    private async Task AddAttachmentsAsync()
    {
        if (isAddingAttachments) return;
        attachmentErrorMessage = null;
        if (TicketId is null || ticket is null || !ticketAttachmentSelection.IsValid || ticketAttachmentSelection.Files.Count == 0)
        {
            attachmentErrorMessage = "Wybierz poprawne pliki i zgłoszenie.";
            return;
        }

        isAddingAttachments = true;
        var targetTicketId = ticket.Id;
        var selectedFiles = ticketAttachmentSelection.Files;
        try
        {
            var authentication = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            if (authentication.User.Identity?.IsAuthenticated != true)
            {
                attachmentErrorMessage = "Zaloguj się ponownie, aby dodać pliki.";
                return;
            }
            var drafts = await AttachmentUpload.ReadAsync(selectedFiles);
            await using var db = await DbContextFactory.CreateDbContextAsync();
            var actor = await TicketAccess.GetActorAsync(db, authentication.User);
            var target = actor is null ? null : await TicketAccess.VisibleTickets(db, actor)
                .SingleOrDefaultAsync(item => item.Id == targetTicketId);
            if (actor is null || target is null || !actor.CanReply(target))
            {
                attachmentErrorMessage = "Nie masz uprawnień do dodawania plików do tego zgłoszenia.";
                return;
            }
            var files = AttachmentUpload.CreateEntities(drafts, actor.Account.Id);
            foreach (var file in files) file.TicketId = target.Id;
            db.TicketAttachments.AddRange(files);
            target.UpdatedAt = DateTime.UtcNow;
            await db.SaveChangesAsync();

            if (ticket?.Id == target.Id)
            {
                attachments.AddRange(files.Select(ToAttachmentInfo));
                ticket.UpdatedAt = target.UpdatedAt;
                ticketAttachmentSelection = AttachmentSelection.Empty;
                ticketAttachmentVersion++;
            }
        }
        catch (InvalidDataException exception)
        {
            attachmentErrorMessage = exception.Message;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Nie udało się dodać załączników do zgłoszenia {TicketId}.", TicketId);
            attachmentErrorMessage = "Nie udało się zapisać załączników. Spróbuj ponownie.";
        }
        finally
        {
            isAddingAttachments = false;
        }
    }

    private static AttachmentInfo ToAttachmentInfo(TicketAttachment file)
        => new(file.Id, file.FileName, file.Size, file.TicketCommentId, file.CreatedAt);

    private static string FormatDate(DateTime? date)
    {
        return date?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "Brak";
    }

    private static string GetStatusName(TicketStatus status) => status switch
    {
        TicketStatus.New => "Nowe",
        TicketStatus.InProgress => "W trakcie",
        TicketStatus.Pending => "Oczekujące",
        TicketStatus.Closed => "Zamknięte",
        _ => "Nieznany status"
    };

    private static string GetInitials(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "??";
        }

        var parts = value.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return string.Concat(parts.Take(2).Select(part => char.ToUpperInvariant(part[0])));
    }

    private string GetCategoryName(TicketCategory cat)
    {
        switch (cat)
        {
            case TicketCategory.Other:
                return "Inne";
            case TicketCategory.Hardware:
                return "Sprzęt";
            case TicketCategory.Software:
                return "Oprogramowanie";
            case TicketCategory.Network:
                return "Sieć";
        }

        return "Nieznana kategoria";
    }
}
