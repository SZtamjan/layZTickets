@page "/counter"
@rendermode InteractiveServer
@inject ILayZJsonManager LayZJsonManager

<PageTitle>Counter</PageTitle>

<h1>Counter</h1>

<p role="status">Current count: @currentCount</p>

<button class="btn btn-primary" @onclick="IncrementCount">Click me</button>

<button class="btn btn-primary" @onclick="ReadCount">Read Save file</button>

@code {
    private int currentCount = 0;

    private async Task IncrementCount()
    {
        currentCount++;
        await LayZJsonManager.SaveAsync(currentCount, "ticket.json");
    }

    private async Task ReadCount()
    {
        currentCount = await LayZJsonManager.LoadAsync<int>("ticket.json");
    }
}
