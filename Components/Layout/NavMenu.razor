<div class="service-sidebar">
    <div class="brand">
        <a class="brand-title" href="/">layZTickets</a>
        <p>System zgłoszeń IT</p>
    </div>

    <input type="checkbox" aria-label="Menu nawigacji" aria-controls="main-navigation" class="navbar-toggler" />

    <nav id="main-navigation" class="nav-scrollable" aria-label="Nawigacja główna">
        <AuthorizeView Roles="Admin,Agent">
            <NavLink class="nav-link" href="dashboard">
                <span class="material-symbols-outlined" aria-hidden="true">dashboard</span>
                <span>Dashboard</span>
            </NavLink>
        </AuthorizeView>

        <AuthorizeView Roles="Admin">
            <NavLink class="nav-link" href="admin">
                <span class="material-symbols-outlined"
                      aria-hidden="true">admin_panel_settings</span>
                <span>Panel administratora</span>
            </NavLink>
        </AuthorizeView>

        <NavLink class="nav-link" href="DisplayTickets">
            <span class="material-symbols-outlined" aria-hidden="true">view_list</span>
            <span>Zgłoszenia</span>
        </NavLink>

        <NavLink class="nav-link" href="CreateTicket">
            <span class="material-symbols-outlined" aria-hidden="true">add_circle</span>
            <span>Nowe zgłoszenie</span>
        </NavLink>
    </nav>

    <AuthorizeView Context="authState">
        <Authorized>
            <details class="user-menu">
                <summary class="sidebar-user">
                    <span class="sidebar-avatar">
                        @GetInitials(GetDisplayName(authState.User))
                    </span>
                    <span>
                        <strong>@GetDisplayName(authState.User)</strong>
                        <span class="sidebar-role">
                            @(authState.User.IsInRole("Admin") ? "Administrator" : authState.User.IsInRole("Agent") ? "Agent" : "Użytkownik")
                        </span>
                    </span>
                </summary>

                <div class="user-menu-panel">
                    <a href="/profile">Mój profil</a>
                    <form action="/logout" method="post">
                        <AntiforgeryToken />
                        <button type="submit">Wyloguj</button>
                    </form>
                </div>
            </details>
        </Authorized>
    </AuthorizeView>
</div>

@code{

    private static string GetDisplayName(ClaimsPrincipal user)
    {
        var firstName = user.FindFirstValue(ClaimTypes.GivenName);
        var lastName = user.FindFirstValue(ClaimTypes.Surname);
        var fullName = $"{firstName} {lastName}".Trim();

        // Starsze cookie nie ma jeszcze nowych danych; ponowne logowanie je uzupełni.
        return string.IsNullOrWhiteSpace(fullName)
            ? user.Identity?.Name ?? "Użytkownik"
            : fullName;
    }

    private string GetInitials(string? userName)
    {
        // UU stands for Unknown User

        if (string.IsNullOrWhiteSpace(userName))
            return "UU";

        string[] words = userName.Split(' ', StringSplitOptions.RemoveEmptyEntries);

        if (words.Length == 1)
            return words[0][0].ToString().ToUpperInvariant();

        char first = words[0][0];
        char last = words[^1][0];
        
        return $"{first}{last}".ToUpperInvariant();
    }
}
