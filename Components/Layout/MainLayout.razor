@inherits LayoutComponentBase
@inject NavigationManager Navigation

<a class="skip-link" href="@(Navigation.Uri.Split('#')[0] + "#main-content")" data-enhance-nav="false">Przejdź do treści</a>
<div class="app-shell">
    <aside class="sidebar">
        <NavMenu />
    </aside>

    <main class="app-main">
        <header class="top-app-bar">
            <span class="app-title">layZTickets</span>
        </header>

        <article id="main-content" class="content" tabindex="-1">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" role="alert">
    Wystąpił problem z aplikacją.
    <a href="" class="reload">Odśwież stronę</a>
    <button type="button" class="dismiss" aria-label="Zamknij komunikat błędu">×</button>
</div>
